{
  "name": "scientific-illustrator",
  "version": "1.5.3",
  "description": "Design or recreate scientific figures in draw.io, Microsoft PowerPoint, or WPS Presentation with editable objects, background-safe drawing, live Office.js support, and one Designer-Drawer-Reviewer-Corrector workflow.",
  "author": {
    "name": "科研up主:进击的土博",
    "url": "https://github.com/icebird1998"
  },
  "homepage": "https://github.com/icebird1998/scientific-illustrator#readme",
  "repository": "https://github.com/icebird1998/scientific-illustrator",
  "license": "MIT",
  "keywords": [
    "scientific-illustration",
    "drawio",
    "powerpoint",
    "wps",
    "pptx",
    "editable-figure",
    "mcp"
  ],
  "mcpServers": {
    "drawio-live": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/live-server.mjs"]
    },
    "drawio-file-utils": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/server.mjs"]
    },
    "powerpoint-live": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/powerpoint-server.mjs"]
    }
  }
}
